{
  "name": "popout-authenticator",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config share-page/vite.config.ts",
    "build:chrome": "tsc --noEmit && vite build --mode chrome",
    "build:edge": "tsc --noEmit && vite build --mode edge",
    "build:firefox": "tsc --noEmit && vite build --mode firefox",
    "build:safari": "tsc --noEmit && vite build --mode safari",
    "build:browsers": "tsc --noEmit && vite build --mode chrome && vite build --mode edge && vite build --mode firefox && vite build --mode safari && vite build --config share-page/vite.config.ts",
    "build:share": "vite build --config share-page/vite.config.ts",
    "test": "vitest run",
    "e2e": "node tests/e2e/run.mjs",
    "e2e:firefox": "node tests/e2e/firefox.mjs",
    "pack": "npm run build && node scripts/pack.mjs",
    "pack:browsers": "npm run build:browsers && node scripts/pack.mjs chrome edge firefox safari"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "jsqr": "^1.4.0",
    "preact": "^10.24.0",
    "qrcode-generator": "^1.4.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.20.5",
    "fake-indexeddb": "^6.0.0",
    "puppeteer-core": "^25.13.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
